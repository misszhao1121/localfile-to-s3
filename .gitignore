# rustfs-migrate 本地 Git 忽略规则
# 核心原则：任何真实凭证、状态数据、构建产物不入库

# ---- 配置文件：只保留模板，真实配置一律本地 ----
config.conf
*.conf
!config.example.conf
!testdata/smoke.conf

# ---- 状态与运行时数据 ----
state/
*.db
*.db-wal
*.db-shm
*.log
scan.done

# ---- 构建产物 ----
dist/
*.exe
rustfs-migrate
rustfs-migrate-linux-amd64
rustfs-migrate-windows-amd64.exe
dbtool
dbtool.exe

# ---- 本地测试数据（源文件树/状态库/预传脚本产物）----
testdata/smoke_src/
testdata/smoke_state/
testdata/*.db

# ---- Go / IDE ----
.gopath/
vendor/
.idea/
.vscode/
*.swp

testdata/stress_src/
